<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kama.jchatmind.mapper.ChatMessageSummaryMapper">

    <resultMap id="BaseResultMap" type="com.kama.jchatmind.model.entity.ChatMessageSummary">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="sessionId" column="session_id" jdbcType="VARCHAR"/>
        <result property="summaryContent" column="summary_content" jdbcType="VARCHAR"/>
        <result property="messageRange" column="message_range" jdbcType="VARCHAR"/>
        <result property="originalMessageCount" column="original_message_count" jdbcType="INTEGER"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,session_id,summary_content,
        message_range,original_message_count,created_at
    </sql>

    <insert id="insert" parameterType="com.kama.jchatmind.model.entity.ChatMessageSummary"
            keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO chat_message_summary
        (
            session_id,
            summary_content,
            message_range,
            original_message_count,
            created_at
        )
        VALUES
            (
                CAST(#{sessionId} AS uuid),
                #{summaryContent},
                #{messageRange},
                #{originalMessageCount},
                #{createdAt}
            )
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM chat_message_summary
        WHERE id = CAST(#{id} AS uuid)
    </select>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM chat_message_summary
        WHERE session_id = CAST(#{sessionId} AS uuid)
        ORDER BY created_at ASC
    </select>

    <select id="selectLatestBySessionId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM chat_message_summary
        WHERE session_id = CAST(#{sessionId} AS uuid)
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM chat_message_summary
        WHERE session_id = CAST(#{sessionId} AS uuid)
    </delete>

    <delete id="deleteById">
        DELETE FROM chat_message_summary
        WHERE id = CAST(#{id} AS uuid)
    </delete>

</mapper>
